# IRIDIUM API - production-style Dockerfile
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

COPY pyproject.toml .
COPY packages/schemas packages/schemas
COPY services/digital-twin services/digital-twin
COPY services/forecasting services/forecasting
COPY services/routing services/routing
COPY services/equity services/equity
COPY services/anomaly-detection services/anomaly-detection
COPY services/ingestion services/ingestion
COPY apps/api apps/api

RUN pip install --no-cache-dir -e ./packages/schemas \
    && pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings python-dotenv structlog \
    && pip install --no-cache-dir -e ./apps/api

# Non-root user
RUN useradd -m iridium
USER iridium

WORKDIR /app/apps/api
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
