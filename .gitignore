# -----------------------------------------------------------------------------
# Strict: any path matching below must not be committed
# -----------------------------------------------------------------------------
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/node_modules/
**/.next/
**/.venv/
**/venv/
**/env/
**/*.egg-info/
**/dist/
**/build/
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/Thumbs.db
**/*.log
**/secrets/
**/.secrets
**/*.pem
**/*.key
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
