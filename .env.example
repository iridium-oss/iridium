# IRIDIUM local development. Copy to .env and adjust. Do not commit .env.

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
APP_VERSION=0.2.0-dev

# PostgreSQL and PostGIS (required for real network; run fetch_osm and network-import)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iridium
POSTGRES_PASSWORD=iridium
POSTGRES_DB=iridium
# Or single DSN:
# POSTGRES_DSN=postgresql://iridium:iridium@localhost:5432/iridium

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Traffic provider (when configured; otherwise traffic layer returns configuration_required)
TRAFFIC_PROVIDER=tomtom
TRAFFIC_API_KEY=
# Or: TOMTOM_API_KEY=

# Traccar (optional; consent-based telemetry)
TRACCAR_HOST=
TRACCAR_USER=
TRACCAR_PASSWORD=

# Open-Meteo: no key required for basic use. Weather ingestion uses it by default.
# WEATHER_LOCATIONS= optional JSON or config path for Baku/Quba

# Data paths (for ingestion input; use real or recorded snapshot paths only)
DATA_SAMPLES_DIR=data/samples
# Equity: real or recorded district_scores.json directory. When unset, equity API returns data_status unavailable.
# EQUITY_DATA_PATH=
# Do not use synthetic in main runtime path. Synthetic only in test fixtures.
# DATA_SYNTHETIC_DIR is not used in main path.

# OSM raw source (output of fetch_osm_azerbaijan.py)
# OSM_DATA_DIR=infrastructure/raw-sources/osm

# OpenTripPlanner (when built)
# OTP_GRAPH_DIR=
# OTP_PORT=8080

# Valhalla (optional)
# VALHALLA_URL=http://localhost:8002

# Kafka (optional event streaming)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Observability
# PROMETHEUS_PORT=9090
# GRAFANA_URL=http://localhost:3001
