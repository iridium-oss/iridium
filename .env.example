# IRIDIUM local development. Copy to .env and adjust. Do not commit .env.

# Canonical settings (preferred)
IRIDIUM_CORE__ENVIRONMENT=development
IRIDIUM_CORE__APP_NAME=iridium-api
IRIDIUM_CORE__APP_VERSION=0.2.0-dev
IRIDIUM_CORE__API_HOST=0.0.0.0
IRIDIUM_CORE__API_PORT=8000
IRIDIUM_CORE__API_BASE_URL=http://localhost:8000
IRIDIUM_CORE__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IRIDIUM_CORE__CORS_ALLOW_CREDENTIALS=false
IRIDIUM_CORE__CORS_ALLOW_METHODS=GET,POST,OPTIONS
IRIDIUM_CORE__CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
IRIDIUM_CORE__LOG_LEVEL=INFO
IRIDIUM_CORE__MAX_REQUEST_BODY_BYTES=1048576
IRIDIUM_CORE__HSTS_ENABLED=false
IRIDIUM_CORE__HSTS_MAX_AGE_SECONDS=31536000

IRIDIUM_DB__ENABLED=false
# IRIDIUM_DB__DSN=postgresql+psycopg://iridium:iridium@localhost:5432/iridium

IRIDIUM_CACHE__ENABLED=false
# IRIDIUM_CACHE__REDIS_URL=redis://localhost:6379/0

IRIDIUM_PROVIDERS__OPEN_METEO_ENABLED=true
IRIDIUM_PROVIDERS__YANDEX_OBSERVED_ENABLED=true
IRIDIUM_PROVIDERS__TWOGIS_ENABLED=false
IRIDIUM_PROVIDERS__MOOVIT_ENABLED=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
APP_VERSION=0.2.0-dev

# PostgreSQL and PostGIS (required for real network; run fetch_osm and network-import)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iridium
POSTGRES_PASSWORD=iridium
POSTGRES_DB=iridium
# Or single DSN:
# POSTGRES_DSN=postgresql://iridium:iridium@localhost:5432/iridium

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Traffic provider (when configured; otherwise traffic layer returns configuration_required)
TRAFFIC_PROVIDER=tomtom
TRAFFIC_API_KEY=
# Or: TOMTOM_API_KEY=

# Traccar (optional; consent-based telemetry)
TRACCAR_HOST=
TRACCAR_USER=
TRACCAR_PASSWORD=

# Open-Meteo: no key required for basic use. Weather ingestion uses it by default.
# WEATHER_LOCATIONS= optional JSON or config path for Baku/Quba

# Data paths (for ingestion input; use real or recorded snapshot paths only)
DATA_SAMPLES_DIR=data/samples
# Equity: real or recorded district_scores.json directory. When unset, equity API returns data_status unavailable.
# EQUITY_DATA_PATH=
# Do not use synthetic in main runtime path. Synthetic only in test fixtures.
# DATA_SYNTHETIC_DIR is not used in main path.

# OSM raw source (output of fetch_osm_azerbaijan.py)
# OSM_DATA_DIR=data/manifests/osm

# OpenTripPlanner (when built)
# OTP_GRAPH_DIR=
# OTP_PORT=8080

# Valhalla (optional)
# VALHALLA_URL=http://localhost:8002

# Kafka (optional event streaming)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Observability
# PROMETHEUS_PORT=9090
# GRAFANA_URL=http://localhost:3001
