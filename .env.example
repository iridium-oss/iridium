# =============================================================================
# IRIDIUM platform environment template
# =============================================================================
# Copy to .env and set values. Do not commit .env. No real secrets in this file.
# Canonical prefix: IRIDIUM_ with nested keys (e.g. IRIDIUM_CORE__API_PORT).
# Legacy names (API_PORT, POSTGRES_HOST, etc.) are supported for compatibility.
# Comment format: Required|Optional | Secret|Non-secret | Subsystem | Description
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core application
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Runtime environment name (development, staging, production)
IRIDIUM_CORE__ENVIRONMENT=development
# Optional | Non-secret | Backend | Service identifier
IRIDIUM_CORE__APP_NAME=iridium-api
# Optional | Non-secret | Backend | Version string
IRIDIUM_CORE__APP_VERSION=0.2.0-dev
# Optional | Non-secret | Backend | Bind host for API server
IRIDIUM_CORE__API_HOST=0.0.0.0
# Optional | Non-secret | Backend | API server port
IRIDIUM_CORE__API_PORT=8000
# Optional | Non-secret | Backend | Public base URL for API (used in responses and docs)
IRIDIUM_CORE__API_BASE_URL=http://localhost:8000
# Optional | Non-secret | Backend | Comma-separated allowed CORS origins
IRIDIUM_CORE__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional | Non-secret | Backend | Allow credentials in CORS responses
IRIDIUM_CORE__CORS_ALLOW_CREDENTIALS=false
# Optional | Non-secret | Backend | Allowed CORS methods
IRIDIUM_CORE__CORS_ALLOW_METHODS=GET,POST,OPTIONS
# Optional | Non-secret | Backend | Allowed CORS headers
IRIDIUM_CORE__CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
# Optional | Non-secret | Backend | Log level (DEBUG, INFO, WARNING, ERROR)
IRIDIUM_CORE__LOG_LEVEL=INFO
# Optional | Non-secret | Backend | Max request body size in bytes (Content-Length enforced)
IRIDIUM_CORE__MAX_REQUEST_BODY_BYTES=1048576
# Optional | Non-secret | Backend | Enable HSTS header; only behind TLS
IRIDIUM_CORE__HSTS_ENABLED=false
# Optional | Non-secret | Backend | HSTS max-age seconds when enabled
IRIDIUM_CORE__HSTS_MAX_AGE_SECONDS=31536000

# Legacy core (deprecated for new config; still read)
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
APP_VERSION=0.2.0-dev

# -----------------------------------------------------------------------------
# 2. Environment and runtime mode
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | When true, API may expose additional debug info (not implemented; reserved)
# DEBUG=false

# -----------------------------------------------------------------------------
# 3. Frontend (apps/web Next.js)
# -----------------------------------------------------------------------------
# Optional | Non-secret | Web | API base URL for client-side fetch (browser). Use when not using rewrites.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional | Non-secret | Web | API base URL for server-side rewrites (next.config.js). Docker: http://api:8000
IRIDIUM_API_INTERNAL_URL=http://localhost:8000
# Optional | Non-secret | Web | Public site URL (reserved; not yet read by code)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional | Non-secret | Web | Default city for map or presets (reserved)
# NEXT_PUBLIC_DEFAULT_CITY=Baku
# Optional | Non-secret | Web | Default map center latitude (reserved)
# NEXT_PUBLIC_MAP_DEFAULT_LAT=40.4093
# Optional | Non-secret | Web | Default map center longitude (reserved)
# NEXT_PUBLIC_MAP_DEFAULT_LNG=49.8671
# Optional | Non-secret | Web | Default map zoom (reserved)
# NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11

# -----------------------------------------------------------------------------
# 4. Backend API configuration
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable Swagger/OpenAPI docs at /docs (default true in FastAPI)
# ENABLE_SWAGGER=true
# Optional | Non-secret | Scripts | Base URL for API in scripts (e.g. measure_api_latency.py)
IRIDIUM_API_BASE=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 5. Database
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable database integration (network-import, digital twin graph)
IRIDIUM_DB__ENABLED=false
# Required when DB enabled | Secret | Backend | PostgreSQL DSN (e.g. postgresql+psycopg://user:pass@host:5432/db)
# IRIDIUM_DB__DSN=postgresql+psycopg://iridium:iridium@localhost:5432/iridium

# Legacy (used by digital-twin, network-import, alembic)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iridium
POSTGRES_PASSWORD=iridium
POSTGRES_DB=iridium
# Or single DSN (overrides host/port/user/pass/db)
# POSTGRES_DSN=postgresql://iridium:iridium@localhost:5432/iridium

# -----------------------------------------------------------------------------
# 6. Redis / cache
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable Redis caching
IRIDIUM_CACHE__ENABLED=false
# Required when cache enabled | Secret if password set | Backend | Redis URL (no password = safe for example)
IRIDIUM_CACHE__REDIS_URL=redis://localhost:6379/0

REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 7. Logging and observability
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable Prometheus-style metrics endpoint
IRIDIUM_OBSERVABILITY__METRICS_ENABLED=false
# Optional | Non-secret | Backend | Log HTTP request timing
IRIDIUM_OBSERVABILITY__LOG_HTTP_TIMING=true
# Optional | Non-secret | Local/CI | Prometheus scrape port (when with-observability profile)
PROMETHEUS_PORT=9090
# Optional | Non-secret | Local/CI | Grafana URL for dashboards
GRAFANA_URL=http://localhost:3001
# Optional | Secret | Production | Sentry DSN (reserved; not yet wired)
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# 8. Security and auth
# -----------------------------------------------------------------------------
# CORS and HSTS are in Core (IRIDIUM_CORE__CORS_*, IRIDIUM_CORE__HSTS_*).
# No session or JWT auth in current codebase; add SECRET_KEY or JWT_SECRET when implemented.
# Optional | Non-secret | Backend | Comma-separated trusted hosts (reserved)
# TRUSTED_HOSTS=localhost,127.0.0.1
# Optional | Non-secret | Backend | Enable rate limiting (reserved)
# RATE_LIMITING_ENABLED=false

# -----------------------------------------------------------------------------
# 9. Transit providers (global flags)
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable Open-Meteo
IRIDIUM_PROVIDERS__OPEN_METEO_ENABLED=true
# Optional | Non-secret | Backend | Enable public-web observed sources (e.g. Yandex)
IRIDIUM_PROVIDERS__YANDEX_OBSERVED_ENABLED=true
# Optional | Non-secret | Backend | Enable 2GIS when API key is set
IRIDIUM_PROVIDERS__TWOGIS_ENABLED=false
# Optional | Non-secret | Backend | Enable Moovit when API key is set
IRIDIUM_PROVIDERS__MOOVIT_ENABLED=false

# -----------------------------------------------------------------------------
# 10. Azerbaijan-local and transit providers
# -----------------------------------------------------------------------------
# Transit aggregation and AYNA/Baku Metro (no override URLs in code; base URLs hardcoded in adapter)
# Optional | Non-secret | Backend | Enable transit aggregation endpoints
IRIDIUM_TRANSIT__ENABLED=true
# Optional | Non-secret | Backend | Enable AYNA public connector (BakuBus)
IRIDIUM_TRANSIT__BAKUBUS_AYNA_ENABLED=true
# Optional | Non-secret | Backend | Enable Yandex observed transit
IRIDIUM_TRANSIT__YANDEX_OBSERVED_ENABLED=true
# Optional | Non-secret | Backend | Cache TTL seconds for web-observed transit
IRIDIUM_TRANSIT__CACHE_TTL_SECONDS=120

# Optional | Non-secret | Backend | Yandex observed sources enabled
IRIDIUM_YANDEX__ENABLED=true
# Optional | Non-secret | Backend | Default stop URL for observed arrivals (empty = require explicit)
IRIDIUM_YANDEX__DEFAULT_STOP_URL=
# Optional | Non-secret | Backend | Request timeout seconds for Yandex
IRIDIUM_YANDEX__TIMEOUT_SECONDS=8.0

# AYNA: base URLs are hardcoded (map-api.ayna.gov.az). Override not in code; reserved for future.
# AYNA_PROVIDER_ENABLED is implied by IRIDIUM_TRANSIT__BAKUBUS_AYNA_ENABLED.

# Baku Metro: static network from code/manifests; no base URL env in code.
# BAKU_METRO_PROVIDER_ENABLED is implied by transit aggregation.

# Optional | Non-secret | Transit | Raw response cache directory (gitignored)
# IRIDIUM_TRANSIT_CACHE_DIR=.transit_cache
# Optional | Non-secret | Transit | GTFS and feed export output directory
# IRIDIUM_GTFS_OUTPUT_DIR=feed_export

# BakıKart: not implemented; permission or partner required. No env in code.
# iTicket: not implemented; see docs/event-sources.md. No env in code.

# GoMap (optional; settings only; adapter not yet implemented)
# Optional | Secret | Backend | GoMap API key (IRIDIUM_GOMAP__API_KEY or legacy GOMAP_API_KEY)
# IRIDIUM_GOMAP__API_KEY=
# Optional | Non-secret | Backend | GoMap API base URL
IRIDIUM_GOMAP__BASE_URL=
# Optional | Non-secret | Backend | Server IP allowlist for GoMap
GOMAP_ALLOWED_SERVER_IP=

# -----------------------------------------------------------------------------
# 11. Weather providers
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable weather integration
IRIDIUM_WEATHER__ENABLED=true
# Optional | Non-secret | Backend | Weather provider id (open_meteo)
IRIDIUM_WEATHER__PROVIDER_ID=open_meteo
# Optional | Non-secret | Backend | Request timeout seconds
IRIDIUM_WEATHER__TIMEOUT_SECONDS=10.0
# Optional | Non-secret | Backend | Cache TTL seconds for weather responses
IRIDIUM_WEATHER__CACHE_TTL_SECONDS=300
# Open-Meteo: no API key. Base URL not overridden in code.

# -----------------------------------------------------------------------------
# 12. Earth observation providers
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable EO (Sentinel-2) endpoints
IRIDIUM_EO__ENABLED=true
# Optional | Non-secret | Backend | Use Copernicus STAC first, then Earth Search
IRIDIUM_EO__PREFER_COPERNICUS=true
# Optional | Non-secret | Backend | Copernicus Data Space STAC base URL
IRIDIUM_EO__COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
# Optional | Non-secret | Backend | Earth Search STAC base URL (fallback)
IRIDIUM_EO__EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
# Optional | Non-secret | Backend | Scene search cache TTL seconds
IRIDIUM_EO__SEARCH_CACHE_TTL_SECONDS=300

# Copernicus CDSE optional auth (higher limits). Client credentials or username/password.
# Optional | Secret | EO | CDSE username (or legacy CDSE_USERNAME)
# IRIDIUM_EO__CDSE_USERNAME=
# Optional | Secret | EO | CDSE password (or legacy CDSE_PASSWORD)
# IRIDIUM_EO__CDSE_PASSWORD=
# Optional | Secret | EO | CDSE OAuth2 client id (or legacy CDSE_CLIENT_ID)
# IRIDIUM_EO__CDSE_CLIENT_ID=
# Optional | Secret | EO | CDSE OAuth2 client secret (or legacy CDSE_CLIENT_SECRET)
# IRIDIUM_EO__CDSE_CLIENT_SECRET=

# Sentinel Hub (optional; for Process API tiles/statistics when implemented)
# Optional | Non-secret | EO | Sentinel Hub instance ID
IRIDIUM_EO__SENTINEL_HUB_INSTANCE_ID=
# Optional | Non-secret | EO | Sentinel Hub Process API base URL
IRIDIUM_EO__SENTINEL_HUB_BASE_URL=
# Optional | Secret | EO | Sentinel Hub OAuth2 client id (or legacy SENTINEL_HUB_CLIENT_ID)
# IRIDIUM_EO__SENTINEL_HUB_CLIENT_ID=
# Optional | Secret | EO | Sentinel Hub OAuth2 client secret (or legacy SENTINEL_HUB_CLIENT_SECRET)
# IRIDIUM_EO__SENTINEL_HUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 13. Routing providers
# -----------------------------------------------------------------------------
# 2GIS (partner; used by GET /api/v1/transit/partner-routes when key present)
# Optional | Secret | Backend | 2GIS API key (IRIDIUM_TWOGIS__API_KEY or legacy TWOGIS_API_KEY)
# IRIDIUM_TWOGIS__API_KEY=
# Optional | Non-secret | Backend | 2GIS API base URL (adapter uses default)
IRIDIUM_TWOGIS__BASE_URL=

# Moovit (partner; interface only; route API not yet implemented)
# Optional | Secret | Backend | Moovit API key (IRIDIUM_MOOVIT__API_KEY or MOOVIT_API_KEY, MOOVIT_PARTNER_API_KEY)
# IRIDIUM_MOOVIT__API_KEY=
# Optional | Non-secret | Backend | Moovit base URL (IRIDIUM_MOOVIT__BASE_URL or MOOVIT_BASE_URL)
IRIDIUM_MOOVIT__BASE_URL=

# Internal routing (digital twin graph + optional OTP/Valhalla; not in API settings)
# Optional | Non-secret | Routing | OpenTripPlanner graph directory (when OTP used)
OTP_GRAPH_DIR=
# Optional | Non-secret | Routing | OpenTripPlanner service port
OTP_PORT=8080
# Optional | Non-secret | Routing | Valhalla service URL
VALHALLA_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# 14. Event and venue providers
# -----------------------------------------------------------------------------
# iTicket/events: not implemented. See docs/event-sources.md. Reserved:
# ITICKET_ENABLED=false
# EVENT_REFRESH_INTERVAL_MINUTES=60
# EVENT_MAX_LOOKAHEAD_DAYS=30

# -----------------------------------------------------------------------------
# 15. Payment and portal integrations
# -----------------------------------------------------------------------------
# BakıKart: not implemented; permission required. Reserved:
# BAKIKART_PORTAL_ENABLED=false
# ENABLE_PAYMENT_CONTEXT=false

# -----------------------------------------------------------------------------
# 16. Telemetry (Traccar)
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable telemetry ingestion (consent-based)
IRIDIUM_TELEMETRY__ENABLED=false
# Required when telemetry enabled | Non-secret | Backend | Traccar server URL
IRIDIUM_TELEMETRY__TRACCAR_HOST=
# Required when telemetry enabled | Secret | Backend | Traccar username
# IRIDIUM_TELEMETRY__TRACCAR_USER=
# Required when telemetry enabled | Secret | Backend | Traccar password
# IRIDIUM_TELEMETRY__TRACCAR_PASSWORD=
# Legacy names (also read)
TRACCAR_HOST=
# TRACCAR_USER=
# TRACCAR_PASSWORD=

# -----------------------------------------------------------------------------
# 17. Traffic provider
# -----------------------------------------------------------------------------
# Optional | Non-secret | Traffic | Provider name (e.g. tomtom)
TRAFFIC_PROVIDER=tomtom
# Optional | Secret | Traffic | API key for live traffic (or TOMTOM_API_KEY)
TRAFFIC_API_KEY=

# -----------------------------------------------------------------------------
# 18. Network import and data paths
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Enable network import (OSM PBF to PostGIS)
# IRIDIUM_NETWORK__ENABLED=false
# Optional | Non-secret | Backend | Directory for OSM raw sources and manifest
# IRIDIUM_NETWORK__OSM_DATA_DIR=data/manifests/osm

# Optional | Non-secret | Backend | Recorded or sample data directory
# IRIDIUM_CORE__DATA_SAMPLES_DIR=data/samples
# Optional | Non-secret | Backend | Synthetic data directory (tests only)
# IRIDIUM_CORE__DATA_SYNTHETIC_DIR=data/synthetic
# Optional | Non-secret | Backend | Path to equity data directory (district_scores.json); when unset, equity API returns unavailable
# IRIDIUM_CORE__EQUITY_DATA_PATH=
# Legacy
DATA_SAMPLES_DIR=data/samples
# EQUITY_DATA_PATH=
# OSM_DATA_DIR=data/manifests/osm

# -----------------------------------------------------------------------------
# 19. AI / forecasting
# -----------------------------------------------------------------------------
# Optional | Non-secret | Backend | Directory containing forecast artifact (model metadata, weights); when set, /forecast/status and /forecast/models use it
# FORECAST_ARTIFACT_DIR=
# Reserved (not read by code): FORECAST_MODEL_ACTIVE, FORECAST_HORIZON_STEPS, ENABLE_GRAPH_WAVENET, ENABLE_DCRNN_BASELINE

# -----------------------------------------------------------------------------
# 20. Federated learning
# -----------------------------------------------------------------------------
# Federated status and capabilities are returned by API; no env-driven config in current code. Reserved for future Flower/server config:
# FEDERATED_ENABLED=false
# FEDERATED_SERVER_HOST=0.0.0.0
# FEDERATED_SERVER_PORT=9091
# FLOWER_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 21. MLOps / model registry / artifacts
# -----------------------------------------------------------------------------
# FORECAST_ARTIFACT_DIR (see section 19) is the only artifact path in use. Reserved:
# MODEL_ARTIFACT_DIR=
# DATASET_MANIFEST_DIR=
# EXPERIMENT_TRACKING_DIR=
# MODEL_REGISTRY_DIR=

# -----------------------------------------------------------------------------
# 22. DevOps / CI / release
# -----------------------------------------------------------------------------
# Optional | Non-secret | CI | Set by GitHub Actions; do not set in .env
# CI=false
# GITHUB_ACTIONS=false
# GITHUB_TOKEN is provided by Actions; never put in .env

# -----------------------------------------------------------------------------
# 23. Feature flags and demo mode
# -----------------------------------------------------------------------------
# No feature-flag env vars are read by current code. UI capabilities are driven by API and provider status. Reserved for future:
# FEATURE_WUF13_ALIGNMENT=true
# FEATURE_PROVIDER_STATUS_PAGE=true
# FEATURE_EO_OVERLAYS=true
# ENABLE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# 24. Local development and testing
# -----------------------------------------------------------------------------
# Optional | Non-secret | Tests | Use mock services in tests (reserved)
# USE_MOCK_SERVICES_FOR_TESTS=false
# Optional | Non-secret | Tests | Skip tests that call external providers (reserved)
# SKIP_EXTERNAL_PROVIDER_TESTS=false
# Optional | Non-secret | Tests | Test database URL (reserved; tests use conftest paths)
# TEST_DATABASE_URL=
# Optional | Non-secret | Tests | Test Redis URL (reserved)
# TEST_REDIS_URL=
# Optional | Non-secret | Pytest | Extra pytest options (e.g. -v --tb=short)
# PYTEST_ADDOPTS=

# -----------------------------------------------------------------------------
# 25. Event streaming (reserved)
# -----------------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
